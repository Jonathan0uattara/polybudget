rules_version = '2';

// =====================================================================
//  Règles de sécurité PolyBudget
//  1. Seul TON compte (liste ALLOWED) peut accéder à la base.
//  2. Chaque compte ne voit que ses propres données.
//  3. Les données écrites sont vérifiées (types, tailles, formats).
//  Tout ce qui n'est pas explicitement autorisé est refusé.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Remplace COLLE_TON_UID_ICI par ton UID
    // (Console Firebase > Authentification > Utilisateurs > colonne « UID de l'utilisateur »).
    function allowed() {
      return request.auth != null
        && request.auth.uid in ['1pcmET76WYcAXPoesB7N6eX2k4F3'];
    }

    function isOwner(userId) {
      return allowed() && request.auth.uid == userId;
    }

    function validSettings(d) {
      return d.keys().hasOnly(['profile', 'name', 'theme', 'categories', 'budgets', 'monthlyBudget', 'savingsGoal', 'v', 'palette'])
        && (!('palette' in d) || (d.palette is string && d.palette.size() <= 20))
        && (!('theme' in d) || d.theme in ['auto', 'light', 'dark'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 80))
        && (!('categories' in d) || (d.categories is list && d.categories.size() <= 100))
        && (!('budgets' in d) || (d.budgets is map && d.budgets.size() <= 100))
        && (!('monthlyBudget' in d) || (d.monthlyBudget is int && d.monthlyBudget >= 0 && d.monthlyBudget < 100000000))
        && (!('savingsGoal' in d) || (d.savingsGoal is int && d.savingsGoal >= 0 && d.savingsGoal < 100000000))
        && (!('profile' in d) || (d.profile is map && d.profile.size() <= 12));
    }

    function validTx(d) {
      return d.keys().hasOnly(['type', 'amount', 'cat', 'date', 'note', 'createdAt', 'updatedAt', 'imported'])
        && d.type in ['in', 'out']
        && d.amount is int && d.amount > 0 && d.amount < 100000000
        && d.cat is string && d.cat.size() <= 64
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('note' in d) || (d.note is string && d.note.size() <= 200));
    }

    // Réglages, profil, catégories, budgets
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validSettings(request.resource.data);
      allow delete: if false;
    }

    function validGoal(d) {
      return d.keys().hasOnly(['name', 'price', 'cat', 'link', 'photo', 'rAmount', 'rPeriod', 'deposits', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.price is int && d.price > 0 && d.price < 1000000000
        && d.cat is string && d.cat.size() <= 32
        && (!('link' in d) || (d.link is string && d.link.size() <= 600 && d.link.matches('^https?://.*')))
        && (!('photo' in d) || (d.photo is string && d.photo.size() <= 400000 && d.photo.matches('^data:image/jpeg;base64,.*')))
        && (!('rAmount' in d) || (d.rAmount is int && d.rAmount > 0))
        && (!('rPeriod' in d) || d.rPeriod in ['day', 'week', 'month'])
        && d.deposits is list && d.deposits.size() <= 300;
    }

    // Objectifs d'achat et projets
    match /users/{userId}/goals/{goalId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validGoal(request.resource.data);
    }

    // Transactions
    match /users/{userId}/tx/{txId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validTx(request.resource.data);
    }
  }
}
